{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/REPLACE-ME/ca-trust-audit/data/schema/policy-v1.json",
  "title": "ca-trust-audit fixed-version policy file, version 1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "incident_id",
    "data_version",
    "as_of",
    "confidence",
    "os_ca_bundles",
    "packages",
    "sources"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "policy_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "incident_id": { "type": "string" },
    "data_version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$" },
    "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "confidence_rationale": { "type": "string" },
    "unknown_branch_behaviour": { "type": "string", "enum": ["unable_to_assess"] },
    "os_ca_bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "os_ids", "package_manager", "package", "scheme", "as_of", "sources"],
        "properties": {
          "id": { "type": "string" },
          "os_ids": { "type": "array", "items": { "type": "string" } },
          "os_version_prefix": { "type": "string" },
          "package_manager": {
            "type": "string",
            "enum": ["dpkg", "rpm", "pacman", "apk", "brew", "zypper"]
          },
          "package": { "type": "string" },
          "fixed_version": { "type": ["string", "null"] },
          "scheme": { "type": "string", "enum": ["dpkg", "generic"] },
          "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "note": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://" } }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "ecosystem", "kind", "scheme", "branches", "as_of", "sources"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "ecosystem": { "type": "string" },
          "kind": { "type": "string", "enum": ["runtime", "ca-bundle-library", "tool"] },
          "scheme": { "type": "string", "enum": ["dpkg", "generic"] },
          "branches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["match", "fixed"],
              "properties": {
                "match": { "type": "string" },
                "fixed": { "type": ["string", "null"] }
              }
            }
          },
          "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "note": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://" } }
        }
      }
    },
    "watchlist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "ecosystem", "kind", "reason"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "ecosystem": { "type": "string" },
          "kind": { "type": "string", "enum": ["runtime", "ca-bundle-library", "tool"] },
          "reason": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "publisher", "retrieved", "used_for"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "publisher": { "type": "string" },
          "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "used_for": { "type": "string" }
        }
      }
    }
  }
}
